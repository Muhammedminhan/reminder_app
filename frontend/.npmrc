# Suppress GHSA-qwww-vcr4-c8h2 (React Router RSC-mode CSRF bypass).
#
# This advisory covers react-router 7.12.0–8.2.0, which includes the
# current 7.18.1.  The vulnerability requires React Server Components /
# server-actions mode to be active.  This app is a client-side Vite SPA
# using BrowserRouter only — the affected code path is never reached.
#
# Downgrading to <7.12.0 would reintroduce the XSS open-redirect advisory
# (GHSA-2w69-qvjg-hvjx), which IS exploitable in this app.  7.18.1 is the
# correct version; this suppression should be removed once upstream ships
# a release outside the 7.12.0–8.2.0 range.
audit-level=critical
